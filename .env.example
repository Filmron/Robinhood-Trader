# Robinhood MCP Server
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Assets to trade: SYMBOL:TYPE  (types: stock, crypto, option)
ASSETS=AAPL:stock,BTC-USD:crypto,SPY:stock

# Strategy selection — available: sma-crossover, rsi-reversal, momentum, breakout, vwap-reversion
STRATEGY=momentum

# Strategy parameters (comma-separated KEY=VALUE pairs)
# sma-crossover:  short_window=5,long_window=20
# rsi-reversal:   period=14,oversold=30,overbought=70
# momentum:       lookback=5,threshold_pct=2.0
# breakout:       window=20
# vwap-reversion: band_pct=1.0
STRATEGY_PARAMS=lookback=5,threshold_pct=2.0

# How far back to fetch price data: day, week, month, 3month, year
DATA_SPAN=week

# Safety: keep true until you have verified the strategy works
DRY_RUN=true

# How often to re-evaluate (seconds)
POLL_INTERVAL_SECONDS=60
